# Скопируйте в .env (cp .env.example .env). Файл .env не коммитится.
# Полный список и назначение — docs/SPEC.md, Приложение B.
NODE_ENV=development
APP_URL=http://localhost:5173
SITE_URL=http://localhost:4321
API_PORT=3000
COLLAB_PORT=3001
WORKER_PORT=3002

DATABASE_URL=postgres://shibase:shibase@localhost:5432/shibase
VALKEY_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=ru-central1
S3_BUCKET=shibase
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Замените случайными значениями: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=dev-only-session-secret-change-me-0000000000000000000000000000000000
COLLAB_JWT_SECRET=dev-only-collab-secret-change-me-000000000000000000000000000000000

SMTP_URL=smtp://localhost:1025
MAIL_FROM=ШИБЕЙС <no-reply@localhost>

# mock | replay | yandex | gigachat. В разработке и тестах — только mock.
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=
EMBEDDING_PROVIDER=mock
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
AI_MAX_CONCURRENCY=6
AI_EXTRACT_MODEL=pro
AI_ANSWER_MODEL=lite
AI_MERGE_THRESHOLD=0.90
AI_DAILY_BUDGET_RUB=500
LLM_RECORD=0

ADMIN_EMAILS=
GUEST_ENABLED=true
GUEST_EXPERT_EMAIL=
GUEST_EXPERT_PASSWORD=
GUEST_HOURLY_PER_IP=10
GUEST_DAILY_TOTAL=200
PILOT_EXCLUDE_EMAILS=
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
LOG_LEVEL=info
