    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@shibase/config": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "@types/node": "^22.0.0"
  }
}
