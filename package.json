{
  "name": "shibase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit && vitest run tools/claude",
    "test:int": "turbo run test:int",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:int",
    "test:e2e": "echo 'e2e появятся с этапа M1.6' && exit 0",
    "format": "prettier --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "doctor": "node tools/doctor.mjs",
    "licenses:check": "node tools/licenses-check.mjs",
    "db:generate": "pnpm --filter @shibase/db db:generate",
    "db:migrate": "pnpm --filter @shibase/db db:migrate",
    "db:reset": "pnpm --filter @shibase/db db:reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-boundaries": "^7.4.2",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
